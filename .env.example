TECH_AI_MODEL_MANIFEST_PATH=configs/models/tech3-v3-pt-br.json
TECH_AI_RETRIEVAL_LIMIT=4
TECH_AI_MAX_RETRIEVAL_DISTANCE=0.55
TECH_AI_MAX_SOURCE_CHARACTERS=2000
TECH_AI_MAX_ANSWER_CHARACTERS=4000
TECH_AI_MAX_NEW_TOKENS=512
TECH_AI_REPETITION_PENALTY=1.1
TECH_AI_NO_REPEAT_NGRAM_SIZE=4
TECH_AI_TEMPERATURE=0.3

# Autenticação HTTP do assistente. Não versione o .env.
TECH_AI_AUTH_SECRET=altere-esta-chave-secreta
TECH_AI_AUTH_USERS=academic:altere-esta-senha
TECH_AI_AUTH_TOKEN_TTL_SECONDS=28800

# Deve ser o mesmo contrato usado pelo tech-ingestao.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSIONS=384

CHROMA_MODE=cloud
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=dd196ed4-0e12-47bd-83ca-b33c9e61feca
CHROMA_DATABASE=fiap-tech-challenge-3
CHROMA_COLLECTION=medquad_knowledge_minilm_v1

# PostgreSQL/Supabase: diagnóstico com tech-ai check-db; preencher apenas no .env local.
# Senha deve ser codificada para URL. Não enviar esta conexão ao navegador.
TECH_AI_DATABASE_URL=

# Diretório local dos arquivos; somente os metadados ficam no PostgreSQL.
TECH_AI_ATTACHMENT_DIR=.data/attachments

# Azure: serviços desativados por padrão. Chaves e endpoints ficam somente no .env local.
TECH_AI_AZURE_SPEECH_ENABLED=false
TECH_AI_AZURE_SPEECH_KEY=
TECH_AI_AZURE_SPEECH_REGION=brazilsouth
TECH_AI_AZURE_LANGUAGE_ENABLED=false
TECH_AI_AZURE_LANGUAGE_KEY=
TECH_AI_AZURE_LANGUAGE_ENDPOINT=
TECH_AI_AZURE_DOCUMENT_ENABLED=false
TECH_AI_AZURE_DOCUMENT_KEY=
TECH_AI_AZURE_DOCUMENT_ENDPOINT=

# Limites locais conservadores da POC, aplicados antes das futuras chamadas pagas.
TECH_AI_AZURE_MAX_AUDIO_SECONDS=120
TECH_AI_AZURE_MAX_DOCUMENT_PAGES=2
TECH_AI_AZURE_MAX_TEXT_RECORDS=20
TECH_AI_AZURE_MAX_CONCURRENT_REQUESTS=1
